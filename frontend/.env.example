# Streamlit frontend runtime configuration
# These values are read by frontend/app.py from the process environment.

# Local development
SCHEMASAY_API_BASE_URL=http://localhost:8000/api/v1
SCHEMASAY_DEMO_MODE=false

# Production example
# SCHEMASAY_API_BASE_URL=https://api.example.com/api/v1
# SCHEMASAY_DEMO_MODE=false

# Configure the backend separately with ALLOWED_ORIGINS containing
# the exact deployed Streamlit origin and any approved local origins.
