# Platform Database
DATABASE_URL=postgresql://schemasay:change-this-password@localhost:5432/schemasay
POSTGRES_USER=schemasay
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=schemasay
POSTGRES_PORT=5432

# JWT Security
SECRET_KEY=generate-a-strong-random-key-for-production
ALGORITHM=HS256
JWT_ISSUER=schemasay
JWT_AUDIENCE=schemasay-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers (at least one is required for NL-to-SQL and business insights)
# LLM_PROVIDER=auto   # auto | openai | gemini
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.6-flash

# Fernet Encryption Key (for database credential storage)
# Generate this using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Google OAuth (optional — required for Google sign-in)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173
