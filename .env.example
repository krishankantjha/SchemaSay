# Platform Database
DATABASE_URL=postgresql://schemasay:change-this-password@localhost:5432/schemasay
POSTGRES_USER=schemasay
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=schemasay
POSTGRES_PORT=5432

# JWT Security
SECRET_KEY=generate-a-strong-random-key-for-production
ALGORITHM=HS256
JWT_ISSUER=schemasay
JWT_AUDIENCE=schemasay-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Providers
OPENAI_API_KEY=your-openai-api-key-here
# GEMINI_API_KEY=your-gemini-api-key-here

# Fernet Encryption Key (for database credential storage)
# Generate this using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-encryption-key-here

# Connector security
# Remote database connections are denied unless the host is explicitly allowlisted.
ALLOWED_DB_HOSTS=
REQUIRE_DB_HOST_ALLOWLIST=true
# SQLite paths are confined to the application data directory by default.
# Set absolute paths only when intentionally allowing additional roots.
# SQLITE_DATA_DIR=/absolute/path/to/schemasay/backend/data
# ALLOWED_SQLITE_ROOTS=/absolute/path/to/schemasay/backend/data

# Shared rate limiting for multi-worker deployments
REDIS_URL=

# Resource limits
MAX_UPLOAD_BYTES=10000000
MAX_UPLOAD_ROWS=100000
MAX_UPLOAD_COLUMNS=100
MAX_QUERY_ROWS=10000
MAX_QUERY_COLUMNS=200
MAX_QUERY_CELL_BYTES=32768

# Frontend runtime
SCHEMASAY_DEMO_MODE=false
SCHEMASAY_API_BASE_URL=http://localhost:8000/api/v1
